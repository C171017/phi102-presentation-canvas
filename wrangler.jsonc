{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "phi102-presentation-canvas",
  "main": "server/worker.ts",
  "compatibility_date": "2026-11-13",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "phi102.c171017.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist-live",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/media/*"
    ]
  },
  "rules": [
    { "type": "Text", "globs": ["**/greco-2017.txt"], "fallthrough": true }
  ],
  "ratelimits": [
    { "name": "PAPER_EXPLANATION_RATE", "namespace_id": "10201", "simple": { "limit": 24, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "PresentationRoom"
      },
      {
        "name": "SHARED_SLIDES",
        "class_name": "SharedSlideHistory"
      },
      {
        "name": "PAPER_EXPLANATION_QUOTA",
        "class_name": "PaperExplanationQuota"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PresentationRoom"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SharedSlideHistory"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["PaperExplanationQuota"]
    }
  ]
}
