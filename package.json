{
  "name": "phi102-presentation-canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5182 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "gifs:check": "node scripts/generate-gifs.mjs --check",
    "gifs:generate": "node scripts/generate-gifs.mjs",
    "build:live": "tsc --noEmit -p server/tsconfig.json && VITE_LIVE_PRESENTATION=1 npm run build -- --outDir dist-live && rm -f dist-live/readings/greco-2017.pdf",
    "dev:live": "npm run build:live && wrangler dev --port 5192",
    "deploy": "npm run build:live && wrangler deploy"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.162.0"
  }
}
